{
  "name": "game-localizer",
  "version": "1.1.0",
  "description": "Translator MC - Minecraft 模组/资源包 AI 本地化翻译工具",
  "main": "./out/main/index.js",
  "author": "Translator MC",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "node scripts/build-help.js && electron-vite build && electron-builder --win",
    "build:unpack": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "adm-zip": "^0.6.0",
    "js-yaml": "^4.1.0",
    "json5": "^2.2.3",
    "lucide-react": "^1.31.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "@types/adm-zip": "^0.5.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^41.10.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.translatormc.app",
    "productName": "Translator MC",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Translator-MC-mobile-win-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Translator MC",
      "artifactName": "Translator-MC-Setup-win-${version}.${ext}"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "help",
        "to": "help",
        "filter": [
          "**/*.tmhelp"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@41.10.5": true,
    "esbuild@0.21.5": true
  }
}
